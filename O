<!doctype html>
<html lang="pt">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#10172a">
<title>TRONS CITY — Ecos da Escuridão</title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#090e1b;color:#f4f5ff;font-family:system-ui,Arial;touch-action:none}
#game{display:block;width:100vw;height:100vh;background:#10172a}
#hud{position:fixed;inset:0;pointer-events:none}
.panel{background:linear-gradient(145deg,#17233ddd,#0a1124dd);border:1px solid #89a8d477;box-shadow:0 6px 24px #0008;border-radius:13px;padding:8px 12px}
#brand{position:absolute;left:12px;top:10px;font-weight:900;letter-spacing:2px;font-size:13px;color:#c9e9ff;text-shadow:0 2px 8px #4aaaff}
#stats{position:absolute;right:12px;top:10px;width:150px;font-size:11px}
.bar{height:8px;background:#303a53;border-radius:8px;overflow:hidden;margin:4px 0 7px}.fill{height:100%;width:100%;background:linear-gradient(90deg,#38d6a2,#9af7d2)}
#health .fill{background:linear-gradient(90deg,#e64b65,#ff9a9e)}
#crystals{font-size:12px;color:#ffe69b}
#hint{position:absolute;left:50%;top:14px;transform:translateX(-50%);font-size:12px;text-align:center;max-width:50%;color:#d8e6ff;text-shadow:0 2px 5px #000}
#touch{position:fixed;inset:0;pointer-events:none}
.pad{position:absolute;bottom:22px;display:flex;gap:10px;pointer-events:auto}
#move{left:18px;align-items:end}
#actions{right:18px;align-items:end}
.ctrl{width:58px;height:58px;border-radius:50%;border:1px solid #b9d9ff99;background:linear-gradient(145deg,#354d78dd,#101d39ee);color:white;font-size:22px;font-weight:800;box-shadow:0 5px 15px #0008;touch-action:none}
.ctrl.small{width:48px;height:48px;font-size:17px}
.ctrl:active{transform:scale(.94);background:#5275a8}
#left,#right{font-size:25px}
#jump{width:66px;height:66px;background:linear-gradient(145deg,#3b9dca,#17466f)}
#attack{background:linear-gradient(145deg,#c65d79,#64283f)}
#menu{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:#050914d9;padding:20px}
.card{width:min(520px,95vw);background:linear-gradient(145deg,#1b2b49,#0b1225);border:1px solid #8eb8df88;border-radius:20px;padding:22px;box-shadow:0 20px 70px #000b}
h1{margin:0 0 5px;font-size:clamp(26px,6vw,42px);letter-spacing:3px;color:#d7f0ff}
.sub{color:#8ec9ec;font-size:12px;letter-spacing:3px;text-transform:uppercase}
p{line-height:1.5;color:#d4dced;font-size:14px}
button.primary{border:0;border-radius:12px;padding:13px 22px;background:linear-gradient(90deg,#3aa9d5,#6b78dc);color:white;font-weight:900;font-size:15px;width:100%;margin-top:8px}
#pause{position:fixed;right:12px;top:58px;pointer-events:auto;width:38px;height:38px;border-radius:11px;background:#182846dd;border:1px solid #9cb9dc;color:white}
#toast{position:fixed;left:50%;top:22%;transform:translateX(-50%);background:#0b1529eF;border:1px solid #7cc8ef;border-radius:12px;padding:10px 16px;font-size:13px;opacity:0;transition:opacity .25s;pointer-events:none;text-align:center}
@media(min-width:800px){.ctrl{width:64px;height:64px}#jump{width:74px;height:74px}}
</style>
</head>
<body>
<canvas id="game"></canvas>
<div id="hud">
 <div id="brand" class="panel">TRONS CITY <span style="color:#7bd7f5">/ ECOS DA ESCURIDÃO</span></div>
 <div id="hint">Encontra o Santuário da Aurora</div>
 <div id="stats" class="panel"><div>VIDA</div><div class="bar" id="health"><div class="fill" id="hp"></div></div><div>ENERGIA</div><div class="bar"><div class="fill" id="en"></div></div><div id="crystals">✦ Cristais: <b id="count">0</b></div></div>
</div>
<button id="pause">Ⅱ</button>
<div id="touch">
 <div id="move" class="pad"><button class="ctrl" id="left">◀</button><button class="ctrl" id="right">▶</button></div>
 <div id="actions" class="pad"><button class="ctrl small" id="attack">✦</button><button class="ctrl" id="jump">↑</button></div>
</div>
<div id="toast"></div>
<div id="menu"><div class="card">
 <div class="sub">Uma aventura original de plataformas</div>
 <h1>TRONS CITY</h1><div style="font-weight:800;color:#8ddcff;letter-spacing:4px">ECOS DA ESCURIDÃO</div>
 <p>Quando a última estrela caiu, a cidade de Lúmen ficou presa numa noite sem fim. Nilo, um jovem guardião, precisa atravessar florestas esquecidas e ruínas antigas para reacender o Coração da Aurora.</p>
 <p><b>Joga:</b> move-te, salta sobre os perigos, derrota criaturas e recolhe cristais. No telemóvel usa os botões; no computador usa A/D ou ←/→, Espaço para saltar e X para atacar.</p>
 <button class="primary" id="start">COMEÇAR A AVENTURA</button>
 <div style="text-align:center;color:#8296b6;font-size:11px;margin-top:12px">Protótipo jogável • progresso guardado neste dispositivo</div>
</div></div>
<script>
(()=>{
const canvas=document.getElementById('game'),ctx=canvas.getContext('2d');
let W=innerWidth,H=innerHeight,dpr=Math.min(devicePixelRatio||1,2);
function resize(){W=innerWidth;H=innerHeight;canvas.width=W*dpr;canvas.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0)}
addEventListener('resize',resize);resize();
const worldW=4200, groundY=H*.78;
let cam=0, running=false, paused=false, last=0, crystals=0, hp=100, energy=100, toastTimer=0;
const keys={left:false,right:false};
const player={x:90,y:groundY-52,vx:0,vy:0,w:34,h:52,ground:false,face:1,attack:0,inv:0,anim:0};
let platforms=[], gems=[], enemies=[], particles=[], checkpoints=[90,1740,3180], checkpoint=0;
function build(){
 const gy=()=>H*.78;
 platforms=[{x:0,y:gy(),w:620,h:180},{x:700,y:gy(),w:520,h:180},{x:1300,y:gy(),w:500,h:180},{x:1900,y:gy(),w:540,h:180},{x:2540,y:gy(),w:530,h:180},{x:3170,y:gy(),w:600,h:180},{x:3860,y:gy(),w:500,h:180}];
 [[390,gy()-95,150],[820,gy()-125,130],[1080,gy()-70,100],[1450,gy()-115,160],[1690,gy()-175,120],[2050,gy()-100,130],[2300,gy()-155,150],[2670,gy()-110,140],[2910,gy()-175,120],[3320,gy()-125,150],[3550,gy()-185,140],[3900,gy()-115,130]].forEach(a=>platforms.push({x:a[0],y:a[1],w:a[2],h:18}));
 gems=[];for(let x=230;x<4050;x+=145){let plat=platforms.filter(p=>x>p.x-20&&x<p.x+p.w+20).sort((a,b)=>Math.abs(a.y-(gy()-100))-Math.abs(b.y-(gy()-100)))[0];gems.push({x,y:(plat?plat.y:gy())-30-Math.sin(x)*4,got:false,phase:Math.random()*6})}
 enemies=[560,1030,1570,2180,2780,3420,3740].map((x,i)=>({x,y:gy()-36,base:x,min:x-90,max:x+90,v:1.1+(i%3)*.25,hp:2,alive:true,phase:i}));
}
build();addEventListener('resize',()=>{build();player.y=Math.min(player.y,H*.78-player.h)});
function say(t){const el=document.getElementById('toast');el.textContent=t;el.style.opacity=1;toastTimer=2.3}
function rect(x,y,w,h,c){ctx.fillStyle=c;ctx.fillRect(x,y,w,h)}
function round(x,y,w,h,r,c){ctx.fillStyle=c;ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill()}
function drawBackground(){
 const sky=ctx.createLinearGradient(0,0,0,H);sky.addColorStop(0,'#101b36');sky.addColorStop(.58,'#24375a');sky.addColorStop(1,'#10182a');rect(0,0,W,H,sky);
 // moon
 ctx.fillStyle='#d7edff';ctx.globalAlpha=.8;ctx.beginPath();ctx.arc(W*.78, H*.18,30,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;
 // stars
 for(let i=0;i<75;i++){let x=((i*173-cam*.12)%(W+30)+W+30)%(W+30),y=(i*67)%Math.max(100,H*.56);ctx.fillStyle=i%5?'#b7d8f5':'#fff0bd';ctx.globalAlpha=.35+(i%4)*.13;ctx.fillRect(x,y,2,2)}ctx.globalAlpha=1;
 // distant mountains
 for(let layer=0;layer<2;layer++){ctx.beginPath();ctx.moveTo(0,H*.67);for(let x=0;x<=W+60;x+=60){let yy=H*(.48+layer*.09)+Math.sin((x+cam*(.12+layer*.1))*.009)*35+Math.cos(x*.021)*15;ctx.lineTo(x,yy)}ctx.lineTo(W,H);ctx.lineTo(0,H);ctx.closePath();ctx.fillStyle=layer?'#1b3150':'#172845';ctx.fill()}
 // distant city silhouettes
 for(let i=0;i<18;i++){let x=((i*190-cam*.28)%(W+220)+W+220)%(W+220)-60;let h=70+(i*47)%130;rect(x,H*.62-h,48,h,'#14243e');for(let wy=H*.62-h+15;wy<H*.62-10;wy+=19)rect(x+9,wy,5,7,'#6c9cbd66')}
}
function drawWorld(){
 ctx.save();ctx.translate(-cam,0);
 // platforms and ground
 platforms.forEach((p,i)=>{round(p.x,p.y,p.w,p.h,6,i===0?'#263e55':'#243c50');rect(p.x,p.y,p.w,7,'#5e9b9a');for(let x=p.x+12;x<p.x+p.w-8;x+=34){rect(x,p.y+14,18,3,'#3b5b66');if(i%2===0)rect(x+7,p.y+28,3,3,'#9cc6a0')}})
 // foreground grass tufts and crystals
 for(let x=0;x<worldW;x+=55){ctx.strokeStyle='#71a88b';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(x,groundY);ctx.lineTo(x-4,groundY-8-(x%3));ctx.moveTo(x+5,groundY);ctx.lineTo(x+10,groundY-7);ctx.stroke()}
 gems.forEach(g=>{if(g.got)return;let bob=Math.sin(performance.now()*.003+g.phase)*5;ctx.save();ctx.translate(g.x,g.y+bob);ctx.rotate(Math.PI/4);ctx.shadowColor='#6cecff';ctx.shadowBlur=18;rect(-7,-7,14,14,'#8af4ff');rect(-3,-3,6,6,'#fff');ctx.restore()});
 // glowing ancient gate
 let gx=4020;ctx.shadowColor='#72eaff';ctx.shadowBlur=25;round(gx,groundY-150,70,150,30,'#3c9eb4');ctx.shadowBlur=0;round(gx+12,groundY-135,46,135,24,'#142d4a');ctx.fillStyle='#c6faff';ctx.font='12px system-ui';ctx.fillText('AURORA',gx+8,groundY-160);
 enemies.forEach(e=>{if(!e.alive)return;let bob=Math.sin(performance.now()*.006+e.phase)*3;ctx.shadowColor='#ff6386';ctx.shadowBlur=12;round(e.x-17,e.y+bob,34,34,12,'#9d4568');ctx.shadowBlur=0;round(e.x-11,e.y+7+bob,7,7,3,'#fff0c4');round(e.x+4,e.y+7+bob,7,7,3,'#fff0c4');rect(e.x-8,e.y+22+bob,16,3,'#341b35')});
 drawPlayer();
 ctx.restore();
}
function drawPlayer(){
 const x=player.x,y=player.y;let bob=player.ground?Math.sin(player.anim*.2)*1.8:0;
 // shadow
 ctx.globalAlpha=.3;ctx.fillStyle='#000';ctx.beginPath();ctx.ellipse(x+17,groundY+3,20,5,0,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;
 // cape
 ctx.fillStyle='#1a4269';ctx.beginPath();ctx.moveTo(x+10,y+19);ctx.lineTo(x-7-player.vx*1.5,y+45);ctx.lineTo(x+18,y+39);ctx.closePath();ctx.fill();
 // legs
 round(x+7,y+37+bob,9,15,3,'#26334f');round(x+20,y+37-bob,9,15,3,'#26334f');
 // body
 round(x+5,y+16+bob,25,26,8,'#e1b66d');round(x+9,y+20+bob,17,18,5,'#397b9c');
 // head and hair
 round(x+7,y,22,23,8,'#d99a73');round(x+5,y-3,25,11,6,'#25314a');
 rect(player.face===1?22:9,y+9,4,3,'#f7f4dc');
 // scarf
 ctx.fillStyle='#64d8df';ctx.beginPath();ctx.moveTo(x+7,y+19);ctx.lineTo(x-4,y+26);ctx.lineTo(x+10,y+27);ctx.fill();
 if(player.attack>0){ctx.strokeStyle='#9af8ff';ctx.lineWidth=5;ctx.shadowColor='#6beaff';ctx.shadowBlur=15;ctx.beginPath();ctx.arc(x+17+player.face*24,y+27,24,-1.2,1.2);ctx.stroke();ctx.shadowBlur=0}
}
function draw(){
 drawBackground();drawWorld();
 // foreground vignette
 const vg=ctx.createLinearGradient(0,H*.7,0,H);vg.addColorStop(0,'#07101a00');vg.addColorStop(1,'#050b17aa');rect(0,H*.72,W,H*.28,vg);
}
function collide(p){return player.x+player.w>p.x&&player.x<p.x+p.w&&player.y+player.h>=p.y&&player.y+player.h<=p.y+22&&player.vy>=0}
function update(dt){
 if(!running||paused)return;
 player.anim+=dt*14;player.inv=Math.max(0,player.inv-dt);player.attack=Math.max(0,player.attack-dt);
 let dir=(keys.right?1:0)-(keys.left?1:0);player.vx=dir*250;if(dir)player.face=dir;
 player.x=Math.max(0,Math.min(worldW-player.w,player.x+player.vx*dt));
 player.vy+=1450*dt;let oldY=player.y;player.y+=player.vy*dt;player.ground=false;
 platforms.forEach(p=>{if(player.x+player.w>p.x&&player.x<p.x+p.w&&oldY+player.h<=p.y+5&&player.y+player.h>=p.y&&player.vy>=0){player.y=p.y-player.h;player.vy=0;player.ground=true}});
 if(player.y>H+120){player.x=checkpoints[checkpoint];player.y=groundY-100;player.vy=0;hp=Math.max(25,hp-15);say('Caíste! Regressaste ao último marco.')}
 enemies.forEach(e=>{if(!e.alive)return;e.x+=e.v*e.v>0?e.v*dt:e.v*dt;if(e.x<e.min||e.x>e.max)e.v*=-1;
 let near=player.x+player.w>e.x-15&&player.x<e.x+18&&player.y+player.h>e.y+4&&player.y<e.y+34;
 if(near&&player.inv<=0){hp-=12;player.inv=.9;player.vx=-player.face*160;player.vy=-260;say('A criatura da sombra atingiu-te!')}
 if(player.attack>0&&Math.abs((player.x+17+player.face*28)-e.x)<38&&Math.abs(player.y-e.y)<55){e.hp-=.07;if(e.hp<=0){e.alive=false;crystals+=2;for(let i=0;i<12;i++)particles.push({x:e.x,y:e.y,vx:(Math.random()-.5)*170,vy:-Math.random()*180,life:.6})}}
 });
 gems.forEach(g=>{if(!g.got&&Math.abs(player.x+17-g.x)<25&&Math.abs(player.y+24-g.y)<38){g.got=true;crystals++;energy=Math.min(100,energy+5)}});
 if(player.x>1700&&checkpoint<1){checkpoint=1;say('Marco da Floresta activado.');}
 if(player.x>3150&&checkpoint<2){checkpoint=2;say('Marco das Ruínas activado.');}
 if(player.x>4000){running=false;document.querySelector('#menu').style.display='flex';document.querySelector('#menu h1').textContent='A AURORA VOLTOU';document.querySelector('#menu .sub').textContent='CAPÍTULO I CONCLUÍDO';document.querySelector('#menu p').textContent='Nilo reacendeu o primeiro farol. Mas, para além das muralhas, uma voz antiga despertou. A aventura está apenas a começar.';document.querySelector('#start').textContent='JOGAR NOVAMENTE';}
 hp=Math.max(0,hp);energy=Math.max(0,energy-.45*dt);if(energy===0&&Math.random()<.003)hp=Math.max(0,hp-1);
 cam=Math.max(0,Math.min(worldW-W,player.x-W*.38));
 particles.forEach(p=>{p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=500*dt;p.life-=dt});particles=particles.filter(p=>p.life>0);
 document.getElementById('hp').style.width=hp+'%';document.getElementById('en').style.width=energy+'%';document.getElementById('count').textContent=crystals;
 if(hp<=0){hp=100;player.x=checkpoints[checkpoint];player.y=groundY-100;player.vy=0;say('Recuperaste no último marco.');}
 if(toastTimer>0){toastTimer-=dt;if(toastTimer<=0)document.getElementById('toast').style.opacity=0}
}
function loop(t){let dt=Math.min((t-last)/1000||0,.033);last=t;update(dt);draw();requestAnimationFrame(loop)}requestAnimationFrame(loop);
function jump(){if(player.ground&&running&&!paused){player.vy=-570;player.ground=false;}}
function attack(){if(running&&!paused){player.attack=.28;}}
function bindHold(id,key){let el=document.getElementById(id);el.addEventListener('pointerdown',e=>{e.preventDefault();keys[key]=true;el.setPointerCapture(e.pointerId)});['pointerup','pointercancel','lostpointercapture'].forEach(ev=>el.addEventListener(ev,()=>keys[key]=false))}
bindHold('left','left');bindHold('right','right');
document.getElementById('jump').addEventListener('pointerdown',e=>{e.preventDefault();jump()});
document.getElementById('attack').addEventListener('pointerdown',e=>{e.preventDefault();attack()});
addEventListener('keydown',e=>{if(['ArrowLeft','a','A'].includes(e.key))keys.left=true;if(['ArrowRight','d','D'].includes(e.key))keys.right=true;if(e.key===' '||e.key==='ArrowUp')jump();if(e.key==='x'||e.key==='X')attack();if(e.key==='Escape')togglePause()});
addEventListener('keyup',e=>{if(['ArrowLeft','a','A'].includes(e.key))keys.left=false;if(['ArrowRight','d','D'].includes(e.key))keys.right=false});
function togglePause(){if(!running)return;paused=!paused;document.getElementById('toast').textContent=paused?'JOGO PAUSADO':'CONTINUA A AVENTURA';document.getElementById('toast').style.opacity=1;setTimeout(()=>{document.getElementById('toast').style.opacity=0},900)}
document.getElementById('pause').onclick=togglePause;
document.getElementById('start').onclick=()=>{document.getElementById('menu').style.display='none';if(player.x>4000){player.x=90;crystals=0;gems.forEach(g=>g.got=false);enemies.forEach(e=>{e.alive=true;e.hp=2});checkpoint=0;hp=100;energy=100}running=true;paused=false;last=performance.now();say('Segue as luzes azuis. Recolhe cristais e encontra o farol!')};
})();
</script>
</body></html>
